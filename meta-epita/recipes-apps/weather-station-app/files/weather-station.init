#!/bin/sh

DAEMON=/usr/bin/weather-station
PIDFILE=/var/run/weather-station.pid

# Screen
export SSD1306_I2C_DEV=/dev/i2c-1
export SSD1306_ADDR=0x3c
export SSD1306_HEIGHT=32

# Run
case "$1" in
    start)
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
        echo "done"
        ;;
    stop)
        start-stop-daemon -K -p "$PIDFILE"
        rm -f "$PIDFILE"
        echo "done"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        exit 1
        ;;
esac

exit 0